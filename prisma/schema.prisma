// Davlat mulki monitoring platformasi — Prisma schema
// PostgreSQL 15 + pg_trgm (GIN trigram indekslari qo'lda migratsiyada, migrations/*/pg_trgm)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  // "native" — Windows'dagi dev uchun; "debian-openssl-3.0.x" — Docker image uchun
  // (node:22-bookworm-slim). Ikkinchisisiz konteynerda "Query engine not found" chiqadi.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Auth & Rollar ───────────────────────────
// SUPER_ADMIN — tizim egasi.  ADMIN — super admin bilan bir xil, lekin super
// adminni ko'rmaydi.  MODERATOR — hamma obyektni ko'radi, biriktirilgan hudud(lar)
// so'rovlarini QABUL QILADI (1-bosqich).  RAHBARIYAT — moderator qabul qilgan
// so'rovni yakuniy tasdiqlaydi (2-bosqich), 9/10 ni "Bo'sh turgan"ga qaytara oladi.
// IJROCHI — o'z hududi obyektlarini kategoriyaga biriktirish so'rovini yuboradi.
// VIEWER — faqat ko'rish.
enum Role {
  SUPER_ADMIN
  ADMIN
  RAHBARIYAT
  MODERATOR
  IJROCHI
  VIEWER
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique // email YO'Q — login+parol orqali avtorizatsiya
  fullName     String
  passwordHash String
  role         Role    @default(VIEWER)
  isActive     Boolean @default(true)

  // IJROCHI uchun bitta hudud (majburiy, app-level).
  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  // MODERATOR uchun: allRegions=true bo'lsa hamma hudud, aks holda moderatorRegions.
  allRegions       Boolean      @default(false)
  moderatorRegions UserRegion[]

  documents        Document[]                   @relation("UploadedBy")
  assignments      PropertyCategoryAssignment[] @relation("AssignedBy")
  syncRuns         SyncRun[]                    @relation("TriggeredBy")
  auditLogs        AuditLog[]
  requestedChanges CategoryChangeRequest[]      @relation("RequestedBy")
  moderatedChanges CategoryChangeRequest[]      @relation("ModeratorReview")
  approvedChanges  CategoryChangeRequest[]      @relation("RahbarReview")
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([role])
}

// MODERATOR ↔ hudud (ko'p-ko'p). allRegions=true bo'lsa bu jadval e'tiborga olinmaydi.
model UserRegion {
  userId   String
  regionId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@id([userId, regionId])
  @@index([regionId])
}

// ─────────────────────── Hudud & Manba (source) ──────────────────────
model Region {
  id         String               @id @default(cuid())
  code       String               @unique // masalan "TAS", "SAM"
  name       String // "Toshkent shahri" ...
  sortOrder  Int                  @default(0) // rasmiy hisobot shaklidagi tartib
  // Kadastr raqamining birinchi bo'lagi ("10".."23") — masalan 17:15:40:01:02:0184 => Andijon.
  // Hududga biriktirilmagan (respublika darajasidagi) manbaning obyektlari SHU orqali
  // to'g'ri hududga joylashtiriladi. 2419 ta jonli obyektda tekshirilgan: har bir hududda
  // aynan bitta prefiks, hech qanday chalkashish yo'q.
  cadastrePrefix String?           @unique
  properties      Property[]
  users           User[]
  sources         OrganizationSource[]
  moderatorLinks  UserRegion[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

// Har bir hudud+organizatsiya uchun STIR va API config (kelajakda kengayadi)
model OrganizationSource {
  id String @id @default(cuid())
  // SOHA (guruh) nomi — "Ijara markazi", "Davlat aktivlari agentligi"...
  // Dashboard/ro'yxat filtrlari SHU maydon bo'yicha guruhlaydi, shuning uchun bitta
  // sohaning barcha yozuvlarida u AYNAN bir xil bo'lishi shart.
  name String
  // To'liq rasmiy tashkilot nomi — faqat ko'rsatish uchun ("Andijon viloyati Davlat
  // aktivlarini boshqarish boshqarmasi"). `name` bilan aralashtirmang: ilgari ikkalasi
  // bitta maydon edi va seed uzun nomlarni yozgani uchun soha guruhlash buzilardi.
  orgName    String?
  stir       String     @unique // API 1 uchun kalit; tashkilotga xos, global unikal
  // Hududga biriktirilmagan (respublika darajasidagi) manba uchun null — masalan
  // Agentlikning o'zi yoki Direksiya. Ularning obyektlari kadastr prefiksi orqali
  // tegishli hududga taqsimlanadi (`Region.cadastrePrefix`).
  regionId   String?
  region     Region?    @relation(fields: [regionId], references: [id])
  isActive   Boolean    @default(true)
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([stir])
  @@index([name])
}

// ─────────────────────────── Kategoriyalar ───────────────────────────
enum CategorySource {
  INTEGRATION // 1–4: API'dan aniqlanadi
  MANUAL // 5–10: user qo'lda tanlaydi
}

model Category {
  code               Int            @id // 1..10
  nameUz             String
  source             CategorySource
  // 1–8 samaradorlik hisobidan CHIQARIB tashlanadi; qolganlari samarasiz.
  excludeInefficient Boolean        @default(false)
  requiresDocument   Boolean        @default(false) // MANUAL kategoriyalar uchun PDF majburiy

  assignments             PropertyCategoryAssignment[]
  integrationOfProperties Property[]                   @relation("IntegrationCategory")
  manualOfProperties      Property[]                   @relation("ManualCategory")
}

// ─────────────────────────── Obyekt (Property) ───────────────────────
enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

model Property {
  id String @id @default(cuid())

  // Kadastr raqamlari — eng muhim qidiruv/filtr maydonlari
  cadNumber    String  @unique // yangi kadastr (API 2)
  cadNumberOld String? // eski kadastr (API 2 javobidan, fallback uchun)

  regionId String
  region   Region             @relation(fields: [regionId], references: [id])
  sourceId String
  source   OrganizationSource @relation(fields: [sourceId], references: [id])

  // API 2 dan keladigan asosiy ma'lumotlar
  name         String?
  address      String?
  area         Decimal? @db.Decimal(14, 2)
  buildingArea Decimal? @db.Decimal(14, 2)
  rawApi2      Json? // to'liq javob (audit/kelajak uchun)

  // Hisoblangan holat (materialized — dashboard tezligi uchun)
  integrationCategoryCode Int? // 1–4 (integratsiyadan)
  integrationCategory     Category? @relation("IntegrationCategory", fields: [integrationCategoryCode], references: [code])
  manualCategoryCode      Int? // 5–10 (qo'lda)
  manualCategory          Category? @relation("ManualCategory", fields: [manualCategoryCode], references: [code])
  isInefficient           Boolean   @default(false) // 1–8 dan tashqarida => true

  // ── Auksion ma'lumotlari (API 3 + API 4) ──
  lotNumber          String? // e-auksion lot raqami (havola shu bo'yicha quriladi)
  lotStatus          String? // "Lot yakunlandi", "Савдода" ...
  auctionOrderId     Int? // API 4 dagi order_id
  auctionStatusId    Int? // order_statuses_id (6 => sotilgan)
  auctionStatus      String? // "Auksion muvaffaqiyatli yakunlandi" ...
  termPayment        Int? // order.term_payment (1 => BO'LIB TO'LASH — asosiy mezon)
  paymentTermMonths  Int? // order.term_month / details "tulov_muddati" (faqat ko'rsatish uchun)
  auctionCheckedAt   DateTime?
  auctionGroupName   String? // API 4 group_name (ijara savdosi / xususiylashtirish)

  // Bitta obyekt bir vaqtda HAM xususiylashtirish, HAM ijara savdosida bo'lishi mumkin
  // (real ma'lumotda 46 ta shunday). Shuning uchun ikkita alohida bayroq —
  // "bitta obyekt = bitta kategoriya" modeli bu yerda yetarli emas.
  hasPrivatizationLot Boolean @default(false)
  hasRentLot          Boolean @default(false)
  /** Auksionga chiqarilgan jami maydon (barcha lotlar bo'yicha, kv.m) */
  auctionTotalArea    Decimal? @db.Decimal(14, 2)
  auctionLots         AuctionLot[]

  // ── Ijara shartnomalari (API 5) — tafsilotlar RentContract jadvalida ──
  rentContractCount  Int? // nechta ijara shartnomasi bor
  rentTotalSum       Decimal? @db.Decimal(18, 2) // jami summa (0 => tekin foydalanish)
  rentTotalArea      Decimal? @db.Decimal(14, 2) // jami ijara maydoni (kv.m)
  /**
   * Bo'sh maydon = foydali maydon − ijaraga berilgan (manfiy bo'lsa 0).
   * Ustun sifatida saqlanadi: Prisma ikki ustunni o'zaro solishtira olmaydi,
   * shuning uchun filtr/aggregat uchun oldindan hisoblab qo'yamiz.
   */
  vacantArea         Decimal? @db.Decimal(14, 2)
  /** Ijara ma'lumoti ESKI kadastr raqami orqali topilganmi. */
  rentMatchedByOldCad Boolean @default(false)
  rentCheckedAt      DateTime?
  rentContracts      RentContract[]

  // Sinxronizatsiya holati
  syncStatus    SyncStatus @default(PENDING)
  lastSyncedAt  DateTime?
  lastSyncError String?

  statusChecks ObjectStatusCheck[]
  assignments    PropertyCategoryAssignment[]
  documents      Document[]
  changeRequests CategoryChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Indekslar (80k+ uchun) ──
  @@index([cadNumberOld])
  @@index([regionId, isInefficient])
  @@index([sourceId])
  @@index([syncStatus])
  @@index([integrationCategoryCode])
  @@index([manualCategoryCode])
  @@index([lotNumber])
  // pg_trgm GIN indekslari migratsiyada qo'lda qo'shiladi (prisma/migrations/*_pg_trgm)
}

enum AuctionLotType {
  PRIVATIZATION // xususiylashtirish savdosi (API 3 + 4)
  RENT // ijara savdosi (API 6)
}

// Auksion lotlari. Bitta kadastr obyekti bo'lib-bo'lib bir nechta lotga chiqarilishi
// mumkin (real ma'lumotda bitta obyektda 13 tagacha ijara loti uchradi).
model AuctionLot {
  id           String         @id @default(cuid())
  propertyId   String
  property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type         AuctionLotType
  lotNumber    String?
  orderId      Int?
  /** Shu lotga chiqarilgan maydon (kv.m) */
  area         Decimal?       @db.Decimal(14, 2)
  startPrice   Decimal?       @db.Decimal(18, 2)
  auctionDate  DateTime?
  lotStatus    String?
  orderStatus  String?
  /** Lot nomi (API 6 dagi `name`) */
  name         String?
  matchedByOldCad Boolean     @default(false)
  createdAt    DateTime       @default(now())

  @@index([propertyId])
  @@index([lotNumber])
  @@index([type])
}

// Ijara shartnomalari (API 5). Bitta kadastrda bir nechta shartnoma bo'lishi mumkin
// (real ma'lumotda maksimal 18 tagacha uchradi).
model RentContract {
  id             String    @id @default(cuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractNumber String?
  contractDate   DateTime?
  contractSum    Decimal?  @db.Decimal(18, 2)
  rentalArea     Decimal?  @db.Decimal(14, 2)
  ownerTin       String?
  ownerName      String?
  tenantTin      String?
  tenantName     String?
  docLink        String?
  regionName     String?
  districtName   String?
  /** Shu shartnoma ESKI kadastr raqami orqali topilganmi. */
  matchedByOldCad Boolean  @default(false)
  createdAt      DateTime  @default(now())

  @@index([propertyId])
  @@index([contractNumber])
}

// API 3–8 natijalari (har bir manba uchun bitta qator)
model ObjectStatusCheck {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  apiSource       String // "API3".."API8"
  found           Boolean  @default(false)
  matchedByOldCad Boolean  @default(false) // fallback ishga tushdimi
  status          String? // API qaytargan holat
  rawResponse     Json?
  checkedAt       DateTime @default(now())

  @@unique([propertyId, apiSource])
  @@index([apiSource, status])
}

// Kategoriya biriktirish (asosan MANUAL 5–10 uchun, tarix bilan)
model PropertyCategoryAssignment {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categoryCode Int
  category     Category  @relation(fields: [categoryCode], references: [code])
  assignedById String
  assignedBy   User      @relation("AssignedBy", fields: [assignedById], references: [id])
  documentId   String? // asoslovchi PDF
  document     Document? @relation(fields: [documentId], references: [id])
  note         String?
  createdAt    DateTime  @default(now())

  @@index([propertyId])
  @@index([categoryCode])
}

// PDF hujjatlar (local filesystem'da saqlanadi, DB'da faqat metadata)
model Document {
  id           String                       @id @default(cuid())
  propertyId   String
  property     Property                     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User                         @relation("UploadedBy", fields: [uploadedById], references: [id])
  storageKey   String // nisbiy yo'l: region/<id>/property/<cad>/<uuid>.pdf
  fileName     String
  fileSize     Int
  mimeType     String                       @default("application/pdf")
  assignments  PropertyCategoryAssignment[]
  changeRequests CategoryChangeRequest[]
  createdAt    DateTime                     @default(now())

  // Ilova rasmlari (ixtiyoriy, 4tagacha) asosiy PDF hujjatning "bolalari" sifatida
  // saqlanadi — shunda so'rov ham, darhol biriktirish ham bitta FK bilan ishlaydi
  // va PDF o'chirilganda rasmlar ham kaskad o'chadi.
  parentId String?
  parent   Document?  @relation("DocAttachments", fields: [parentId], references: [id], onDelete: Cascade)
  children Document[] @relation("DocAttachments")

  @@index([propertyId])
  @@index([parentId])
}

// ─────────────────── Kategoriya o'zgartirish so'rovi (workflow) ───────────────────
// IJROCHI "Bo'sh turgan" obyektni "Yaroqsiz holat"/"Chekka hudud"ga biriktirish
// SO'ROVINI yuboradi. So'rov IKKI BOSQICHDAN o'tadi va faqat oxirida qo'llanadi:
//   PENDING_MODERATOR  → moderator obyektni o'rganadi, qabul qiladi yoki rad etadi
//   PENDING_RAHBARIYAT → rahbariyat yakuniy qaror qabul qiladi
//   APPROVED           → kategoriya qo'llandi
//   REJECTED           → rad etildi (sababi bilan, ijrochiga xabar boradi)
enum ChangeRequestStatus {
  PENDING_MODERATOR
  PENDING_RAHBARIYAT
  APPROVED
  REJECTED
}

model CategoryChangeRequest {
  id            String              @id @default(cuid())
  propertyId    String
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                @relation("RequestedBy", fields: [requestedById], references: [id])
  fromCategory  Int? // so'rov paytidagi effektiv kategoriya (odatda 11)
  toCategory    Int // 9 (yaroqsiz) yoki 10 (chekka)
  note          String?
  documentId    String?
  document      Document?           @relation(fields: [documentId], references: [id])
  status        ChangeRequestStatus @default(PENDING_MODERATOR)

  // 1-bosqich — moderator (qabul qiluvchi)
  moderatorId   String?
  moderator     User?     @relation("ModeratorReview", fields: [moderatorId], references: [id])
  moderatorNote String?
  moderatorAt   DateTime?

  // 2-bosqich — rahbariyat (yakuniy qaror)
  rahbarId   String?
  rahbar     User?     @relation("RahbarReview", fields: [rahbarId], references: [id])
  rahbarNote String?
  rahbarAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([propertyId])
  @@index([requestedById])
}

// Ilova ichidagi bildirishnoma (email yo'q). Nazoratchiga tasdiq/rad haqida xabar.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ─────────────────────── Sinxronizatsiya jurnali ─────────────────────
enum SyncRunType {
  FULL_ALL
  REGION
  SINGLE
  STATUS_REFRESH // API1/2 siz — mavjud obyektlarga to'g'ridan-to'g'ri holat-API'lar (3-6)
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model SyncRun {
  id            String        @id @default(cuid())
  type          SyncRunType
  status        SyncRunStatus @default(QUEUED)
  triggeredById String?
  triggeredBy   User?         @relation("TriggeredBy", fields: [triggeredById], references: [id])
  regionId      String?
  // Soha (OrganizationSource.name) bo'yicha kesim — hudud bilan birga qo'llanadi.
  sourceName    String?
  // STATUS_REFRESH uchun: qaysi modullar tashqi API'dan qayta so'raladi.
  // FULL_ALL/REGION/SINGLE uchun uchalasi ham true (to'liq zanjir, o'zgarmagan xulq-atvor).
  refreshBase    Boolean @default(true) // API2 — asosiy ma'lumot
  refreshAuction Boolean @default(true) // API3/4 + API6 — auksion va ijara loti (birga, AuctionLot bitta jadval)
  refreshRent    Boolean @default(true) // API5 — ijara shartnomalari
  totalCount    Int           @default(0)
  successCount  Int           @default(0)
  failCount     Int           @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

// Audit (kim, nima, qachon)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // "ASSIGN_CATEGORY", "UPLOAD_DOC", "TRIGGER_SYNC"...
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

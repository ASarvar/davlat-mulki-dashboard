// Davlat mulki monitoring platformasi — Prisma schema
// PostgreSQL 15 + pg_trgm (GIN trigram indekslari qo'lda migratsiyada, migrations/*/pg_trgm)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  // "native" — Windows'dagi dev uchun; "debian-openssl-3.0.x" — Docker image uchun
  // (node:22-bookworm-slim). Ikkinchisisiz konteynerda "Query engine not found" chiqadi.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Auth & Rollar ───────────────────────────
// SUPER_ADMIN — tizim egasi.  ADMIN — super admin bilan bir xil, lekin super
// adminni ko'rmaydi.  MODERATOR — hamma obyektni ko'radi, biriktirilgan hudud(lar)
// so'rovlarini QABUL QILADI (1-bosqich).  RAHBARIYAT — moderator qabul qilgan
// so'rovni yakuniy tasdiqlaydi (2-bosqich), 9/10 ni "Bo'sh turgan"ga qaytara oladi.
// IJROCHI — o'z hududi obyektlarini kategoriyaga biriktirish so'rovini yuboradi.
// VIEWER — faqat ko'rish.
enum Role {
  SUPER_ADMIN
  ADMIN
  RAHBARIYAT
  MODERATOR
  IJROCHI
  VIEWER
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique // email YO'Q — login+parol orqali avtorizatsiya
  fullName     String
  passwordHash String
  role         Role    @default(VIEWER)
  isActive     Boolean @default(true)

  // ⚠️ Foydalanuvchi doirasi HUDUD emas, TASHKILOT bo'yicha (2026-07-30).
  // Har bir obyektda `sourceId` majburiy, shuning uchun cheklash aniq va bo'shliqsiz.
  // Hududiy tashkilotga bog'langan odam amalda faqat o'z hududini ko'radi; respublika
  // darajasidagi tashkilot (Direksiya, Agentlik markaziy) esa barcha hududlarga tarqaladi.

  // IJROCHI uchun aynan bitta tashkilot (majburiy, app-level).
  sourceId String?
  source   OrganizationSource? @relation("UserSource1", fields: [sourceId], references: [id])

  // MODERATOR uchun: allSources=true bo'lsa hamma tashkilot, aks holda moderatorSources.
  allSources       Boolean      @default(false)
  moderatorSources UserSource[]

  documents            Document[]                   @relation("UploadedBy")
  assignments          PropertyCategoryAssignment[] @relation("AssignedBy")
  syncRuns             SyncRun[]                    @relation("TriggeredBy")
  auditLogs            AuditLog[]
  requestedChanges     CategoryChangeRequest[]      @relation("RequestedBy")
  moderatedChanges     CategoryChangeRequest[]      @relation("ModeratorReview")
  approvedChanges      CategoryChangeRequest[]      @relation("RahbarReview")
  notifications        Notification[]
  imtiyozChecks        ImtiyozCheck[]
  sectionAccessUpdates SectionAccess[]              @relation("SectionAccessUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceId])
  @@index([role])
}

// MODERATOR ↔ tashkilot (ko'p-ko'p). allSources=true bo'lsa bu jadval e'tiborga olinmaydi.
model UserSource {
  userId   String
  sourceId String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  source   OrganizationSource @relation("UserSourceMany", fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@index([sourceId])
}

// ─────────────────────── Hudud & Manba (source) ──────────────────────
model Region {
  id               String               @id @default(cuid())
  code             String               @unique // masalan "TAS", "SAM"
  name             String // "Toshkent shahri" ...
  sortOrder        Int                  @default(0) // rasmiy hisobot shaklidagi tartib
  // Kadastr raqamining birinchi bo'lagi ("10".."23") — masalan 17:15:40:01:02:0184 => Andijon.
  // Hududga biriktirilmagan (respublika darajasidagi) manbaning obyektlari SHU orqali
  // to'g'ri hududga joylashtiriladi. 2419 ta jonli obyektda tekshirilgan: har bir hududda
  // aynan bitta prefiks, hech qanday chalkashish yo'q.
  cadastrePrefix   String?              @unique
  properties       Property[]
  sources          OrganizationSource[] @relation("OrgRegion")
  // Respublika darajasidagi manbani shu hududga cheklaydi (masalan Direksiya →
  // faqat Toshkent sh.) — `OrganizationSource.restrictedRegionId` ga qarang.
  restrictedByOrgs OrganizationSource[] @relation("OrgRestrictedRegion")
  districts        District[]
  snapshots        DashboardSnapshot[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

// Tuman/shahar — API 2 javobidagi `district_id` + `district` dan keladi.
// ⚠️ Kalit sifatida NOM emas, `code` (UZKAD `district_id`) ishlatiladi: jonli
// ma'lumotda bitta tumanning nomi ikki xil yozilishi mumkin ("Buxoro sh." /
// "Buxoro shahar"), lekin `district_id` barqaror — 5441 obyektda tekshirilgan:
// bitta nom hech qachon ikki `code`ga, bitta `code` hech qachon ikki hududga
// tegishli bo'lmagan. `name` — kanonik (eng ko'p uchragan) imlo.
model District {
  id         String     @id @default(cuid())
  code       Int        @unique // API 2 `district_id`
  name       String
  regionId   String
  region     Region     @relation(fields: [regionId], references: [id])
  properties Property[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([regionId])
}

// Har bir hudud+organizatsiya uchun STIR va API config (kelajakda kengayadi)
model OrganizationSource {
  id                 String              @id @default(cuid())
  // SOHA (guruh) nomi — "Ijara markazi", "Davlat aktivlari agentligi"...
  // Dashboard/ro'yxat filtrlari SHU maydon bo'yicha guruhlaydi, shuning uchun bitta
  // sohaning barcha yozuvlarida u AYNAN bir xil bo'lishi shart.
  name               String
  // To'liq rasmiy tashkilot nomi — faqat ko'rsatish uchun ("Andijon viloyati Davlat
  // aktivlarini boshqarish boshqarmasi"). `name` bilan aralashtirmang: ilgari ikkalasi
  // bitta maydon edi va seed uzun nomlarni yozgani uchun soha guruhlash buzilardi.
  orgName            String?
  stir               String              @unique // API 1 uchun kalit; tashkilotga xos, global unikal
  // Hududga biriktirilmagan (respublika darajasidagi) manba uchun null — masalan
  // Agentlikning o'zi yoki Direksiya. Ularning obyektlari kadastr prefiksi orqali
  // tegishli hududga taqsimlanadi (`Region.cadastrePrefix`).
  regionId           String?
  region             Region?             @relation("OrgRegion", fields: [regionId], references: [id])
  // ⚠️ `regionId`dan farqli: bu "ko'r-ko'rona ishonch" EMAS. Faqat regionId=null
  // (respublika darajasidagi) manba uchun ma'noli — fan-out bosqichida kadastr
  // PREFIKSI baribir tekshiriladi, natija shu hududga mos kelmasa obyekt olib
  // tashlanadi (yozilmaydi ham, boshqa hududga ham yozilmaydi). Masalan Direksiya
  // → faqat Toshkent sh. (2026-08-05, foydalanuvchi qarori). Bo'sh bo'lsa cheklov yo'q.
  restrictedRegionId String?
  restrictedRegion   Region?             @relation("OrgRestrictedRegion", fields: [restrictedRegionId], references: [id])
  isActive           Boolean             @default(true)
  properties         Property[]
  // Foydalanuvchi doirasi shu tashkilotga bog'lanadi (IJROCHI — bitta, MODERATOR — ko'p).
  ijrochilar         User[]              @relation("UserSource1")
  moderatorLinks     UserSource[]        @relation("UserSourceMany")
  snapshots          DashboardSnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([stir])
  @@index([name])
}

// ─────────────────────────── Kategoriyalar ───────────────────────────
enum CategorySource {
  INTEGRATION // 1–4: API'dan aniqlanadi
  MANUAL // 5–10: user qo'lda tanlaydi
}

model Category {
  code               Int            @id // 1..10
  nameUz             String
  source             CategorySource
  // 1–8 samaradorlik hisobidan CHIQARIB tashlanadi; qolganlari samarasiz.
  excludeInefficient Boolean        @default(false)
  requiresDocument   Boolean        @default(false) // MANUAL kategoriyalar uchun PDF majburiy

  assignments             PropertyCategoryAssignment[]
  integrationOfProperties Property[]                   @relation("IntegrationCategory")
  manualOfProperties      Property[]                   @relation("ManualCategory")
}

// ─────────────────────────── Obyekt (Property) ───────────────────────
enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}

model Property {
  id String @id @default(cuid())

  // Kadastr raqamlari — eng muhim qidiruv/filtr maydonlari
  cadNumber    String  @unique // yangi kadastr (API 2)
  cadNumberOld String? // eski kadastr (API 2 javobidan, fallback uchun)

  regionId   String
  region     Region             @relation(fields: [regionId], references: [id])
  // Tuman — API 2 `district_id` orqali (ixtiyoriy: 5443 obyektdan 2 tasida yo'q).
  districtId String?
  district   District?          @relation(fields: [districtId], references: [id])
  sourceId   String
  source     OrganizationSource @relation(fields: [sourceId], references: [id])

  // API 2 dan keladigan asosiy ma'lumotlar
  name         String?
  address      String?
  area         Decimal? @db.Decimal(14, 2)
  buildingArea Decimal? @db.Decimal(14, 2)
  rawApi2      Json? // to'liq javob (audit/kelajak uchun)

  // Yer uchastkasimi yoki bino — rawApi2'dagi 11 ta maydon (object_area*, object_rooms)
  // HAMMASI 0/bo'sh bo'lsa YER, aks holda BINO (`src/lib/area.ts` → isLandOnly()).
  // Faqat "Davlat aktivlari agentligi" va "Direksiya" balansidagi obyektlar uchun
  // dashboard jadvalida ko'rsatiladi, lekin hisoblanishi barcha obyektlar uchun bir xil.
  isLand Boolean @default(false)

  // ── Balansdan chiqarilgan (2026-08-06) ──
  // API 1 tashkilotning JORIY kadastr ro'yxatini qaytaradi. Ilgari sinxronizatsiya
  // faqat qo'shar/yangilar edi — ro'yxatdan TUSHIB QOLGAN obyekt bazada abadiy qolib,
  // dashboard sonini API'dagidan katta qilib ko'rsatardi (Andijon: API 157, baza 159).
  // Endi `syncSource.ts` har sinxronizatsiyada solishtiradi va bunday obyektni SHU
  // bayroq bilan belgilaydi — O'CHIRMAYDI (foydalanuvchi qarori: tarix saqlanishi kerak).
  //
  // ⚠️ Bunday obyekt dashboard hisoblariga UMUMAN kirmaydi (`stats.ts` → sourceCond/
  // sourceWhere) va obyektlar ro'yxatida ham standart holatda ko'rinmaydi — faqat ADMIN
  // "Balansdan chiqarilgan" kategoriyasini tanlaganda chiqadi (`properties.ts`).
  removedFromBalance Boolean   @default(false)
  removedAt          DateTime?
  /**
   * Yangi egasi — API 2 `subjects[0]` dan (aniqlanmasa null: API javob bermagan bo'lishi mumkin).
   */
  removedToStir      String?
  removedToName      String?

  // Hisoblangan holat (materialized — dashboard tezligi uchun)
  integrationCategoryCode Int? // 1–4 (integratsiyadan)
  integrationCategory     Category? @relation("IntegrationCategory", fields: [integrationCategoryCode], references: [code])
  manualCategoryCode      Int? // 5–10 (qo'lda)
  manualCategory          Category? @relation("ManualCategory", fields: [manualCategoryCode], references: [code])
  isInefficient           Boolean   @default(false) // 1–8 dan tashqarida => true

  // ── Auksion ma'lumotlari (API 3 + API 4) ──
  lotNumber         String? // e-auksion lot raqami (havola shu bo'yicha quriladi)
  lotStatus         String? // "Lot yakunlandi", "Савдода" ...
  auctionOrderId    Int? // API 4 dagi order_id
  auctionStatusId   Int? // order_statuses_id (6 => sotilgan)
  auctionStatus     String? // "Auksion muvaffaqiyatli yakunlandi" ...
  termPayment       Int? // order.term_payment (1 => BO'LIB TO'LASH — asosiy mezon)
  paymentTermMonths Int? // order.term_month / details "tulov_muddati" (faqat ko'rsatish uchun)
  auctionCheckedAt  DateTime?
  auctionGroupName  String? // API 4 group_name (ijara savdosi / xususiylashtirish)

  // Bitta obyekt bir vaqtda HAM xususiylashtirish, HAM ijara savdosida bo'lishi mumkin
  // (real ma'lumotda 46 ta shunday). Shuning uchun ikkita alohida bayroq —
  // "bitta obyekt = bitta kategoriya" modeli bu yerda yetarli emas.
  hasPrivatizationLot Boolean      @default(false)
  hasRentLot          Boolean      @default(false)
  /**
   * Auksionga chiqarilgan jami maydon (barcha lotlar bo'yicha, kv.m)
   */
  auctionTotalArea    Decimal?     @db.Decimal(14, 2)
  auctionLots         AuctionLot[]

  // ── Ijara shartnomalari (API 5) — tafsilotlar RentContract jadvalida ──
  rentContractCount   Int? // nechta ijara shartnomasi bor
  rentTotalSum        Decimal?       @db.Decimal(18, 2) // jami summa (0 => tekin foydalanish)
  rentTotalArea       Decimal?       @db.Decimal(14, 2) // jami ijara maydoni (kv.m)
  /**
   * Bo'sh maydon = foydali maydon − ijaraga berilgan (manfiy bo'lsa 0).
   * Ustun sifatida saqlanadi: Prisma ikki ustunni o'zaro solishtira olmaydi,
   * shuning uchun filtr/aggregat uchun oldindan hisoblab qo'yamiz.
   */
  vacantArea          Decimal?       @db.Decimal(14, 2)
  /**
   * Ijara ma'lumoti ESKI kadastr raqami orqali topilganmi.
   */
  rentMatchedByOldCad Boolean        @default(false)
  rentCheckedAt       DateTime?
  rentContracts       RentContract[]

  // ── Kommunal xizmatlar (suv/gaz/elektr API'lari) ──
  // Xom javoblar `ObjectStatusCheck` da (apiSource = "WATER"/"GAS"/"ELECTRIC"), bu yerda
  // esa dashboard agregati uchun materiallashtirilgan bayroqlar (rentContractCount bilan
  // bir xil printsip: tafsilot alohida jadvalda, hisob-kitob ustunda).
  //
  // ⚠️ "Abonent bor" va "sarflayapti" — IKKI BOSHQA narsa. Jonli o'lchovda 8 ta gaz
  // abonentidan 7 tasida `gas_consume` 12 oy davomida 0 edi (hisob ochiq, sarf yo'q).
  // Shuning uchun `hasGas` va `gasConsuming` alohida ustun.
  //
  // ⚠️ `utilityCheckedAt = null` — "TEKSHIRILMAGAN", "abonent yo'q" EMAS. Bu farq
  // dashboardda alohida ustun bo'lib ko'rsatiladi: API "abonent yo'q" va "bu hudud
  // umuman qamralmagan" holatini farqlay olmaydi (ikkalasi bir xil javob qaytaradi),
  // shuning uchun tekshirilmaganni "foydalanmayapti" deb ko'rsatish xato xulosa bo'lardi.
  hasWater         Boolean   @default(false)
  hasGas           Boolean   @default(false)
  hasElectric      Boolean   @default(false)
  /**
   * Faqat gaz: oxirgi oylarda `gas_consume > 0` — HISOBLAGICH ko'rsatgan haqiqiy sarf.
   * ⚠️ Qat'iy mezon: hisoblagichi yo'q abonentda hamisha `false`.
   */
  gasConsuming     Boolean   @default(false)
  /**
   * Faqat gaz: oxirgi oylarda `accrual > 0` — hisob FAOL, to'lov hisoblanmoqda.
   * Hisoblagichi yo'q abonentda (`meter_number` NULL) `gas_consume` doim 0 bo'ladi, lekin
   * gaz norma bo'yicha hisoblanib to'lov yuritiladi — shu holat uchun alohida bayroq.
   * ⚠️ Amalda kam uchraydi: to'liq ma'lumotda 21 ta gaz abonentidan 19 tasida bu bayroq
   * `gasConsuming` bilan bir xil qiymatda.
   */
  gasBilled        Boolean   @default(false)
  /**
   * Gaz abonentining OXIRGI TO'LOV sanasi (API `abonent.last_payment_date`).
   * ⚠️ Bu `gasBilled` dan KUCHLIROQ dalil: hisob-kitob (`accrual`) abonent to'lamasa ham
   * davom etaveradi va qarz to'planadi, TO'LOV esa kimdir obyektdan foydalanayotganini
   * bildiradi. Jonli ma'lumotda sanalar 2024-yildan 2026-yilgacha tarqalgan — ya'ni
   * "abonenti bor" degan bayroq yopilgan eski hisobni ham, faol hisobni ham bir xil
   * ko'rsatardi (foydalanuvchi shu farqni so'radi, 2026-08-17).
   * Suv API'si `saldo` beradi lekin sana bermaydi. Elektr uchun ayni shu ma'no
   * `electricLastPaymentAt` da (2-bosqich `het_data_detail` dan).
   */
  gasLastPaymentAt DateTime?

  // ── Elektr, 2-bosqich (`het_data_detail`) ──
  // 1-bosqich (`het_data`) faqat abonent kodini beradi, shuning uchun `hasElectric`
  // "shu kadastr bo'yicha kod topildi"dan boshqa hech narsani bildirmasdi. Tafsilot
  // chaqiruvi ism, manzil, balans, oylik sarf va to'lov tarixini beradi.
  /**
   * /**
   * /**
   * Oxirgi `ELECTRIC_CONSUMING_MONTHS` oyda `SALDO_PERIOD.CURRENT_EE_KWH > 0` —
   * ya'ni hisoblagich bo'yicha HAQIQIY elektr sarfi qayd etilgan. Gazdagi
   * `gasConsuming` ning elektr muqobili, lekin ishonchliroq: elektrda hisoblagichsiz
   * abonent deyarli uchramaydi.
   */
  electricConsuming     Boolean   @default(false)
  /**
   * Elektr abonentining oxirgi to'lov sanasi (`LAST_PAYMENT_DATE`).
   */
  electricLastPaymentAt DateTime?
  /**
   * Tafsilotdagi `KADASTR_CODE` obyektning o'z kadastri bilan MOS kelganmi.
   * ⚠️ Bu — qamrov sifatining asosiy o'lchovi. Elektr API'si turar-joy abonentlari
   * bazasiga ulangan va 1-bosqich kadastrni TAXMINAN moslashtiradi: jonli sinovda
   * `20:08:41:01:01:0019` so'rovi `KADASTR_CODE = 20:08:09:01:01:0024` bo'lgan
   * JISMONIY SHAXS abonentini qaytardi. Ya'ni "abonent bor" degan bayroq ko'pincha
   * BOSHQA obyektning uy xo'jaligini ko'rsatadi. Shu ustun bilan haqiqiy moslik
   * soxta moslikdan ajratiladi.
   */
  electricCadastreMatch Boolean   @default(false)
  utilityCheckedAt      DateTime?

  // Sinxronizatsiya holati
  syncStatus   SyncStatus @default(PENDING)
  lastSyncedAt DateTime?

  /**
   * Xaritadagi joylashuv.
   * ⚠️ Manba — AUKSION LOTI (API 4 `order.lat/lng`), kadastr chegarasi EMAS. Shuning
   * uchun qamrov qisman: faqat auksionga chiqarilgan obyektlarda mavjud (~31%).
   * `coordSource` shuni yozib qo'yadi, UI esa buni ochiq ko'rsatadi.
   * ⚠️ `Float`, `Decimal` EMAS: `Decimal` RSC chegarasidan va `unstable_cache`
   * serializatsiyasidan o'tmaydi. API 6 xonagacha aniqlik beradi (≈11 sm) — `double`
   * yetarli. PostGIS ataylab rad etildi: `postgres:15` image'ni almashtirish 1800 ta
   * nuqta uchun oqlanmaydi.
   */
  lat           Float?
  lng           Float?
  /**
   * Koordinata qayerdan olingani ("AUCTION") — kelajakda boshqa manba qo'shilishi mumkin.
   */
  coordSource   String?
  coordsAt      DateTime?
  lastSyncError String?

  statusChecks   ObjectStatusCheck[]
  assignments    PropertyCategoryAssignment[]
  documents      Document[]
  changeRequests CategoryChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // pg_trgm GIN indekslari migratsiyada qo'lda qo'shiladi (prisma/migrations/*_pg_trgm)

  // ── Indekslar (80k+ uchun) ──
  @@index([cadNumberOld])
  @@index([regionId, isInefficient])
  @@index([districtId])
  @@index([sourceId])
  @@index([syncStatus])
  // Xarita so'rovi faqat koordinatasi bor obyektlarni oladi.
  @@index([lat, lng])
  @@index([integrationCategoryCode])
  @@index([manualCategoryCode])
  @@index([lotNumber])
  // Kommunal jadvali hudud kesimida "tekshirilgan/tekshirilmagan" bo'yicha ajratadi.
  @@index([utilityCheckedAt])
  // "Oxirgi N oyda to'lov" ustuni/filtri shu bo'yicha oraliq qidiradi.
  @@index([gasLastPaymentAt])
  // Balansdan chiqarilganlar HAR BIR ro'yxat/statistika so'roviga shart sifatida
  // qo'shiladi (deyarli hamma joyda `= false`), shuning uchun indeks kerak.
  @@index([removedFromBalance])
}

enum AuctionLotType {
  PRIVATIZATION // xususiylashtirish savdosi (API 3 + 4)
  RENT // ijara savdosi (API 6)
}

// Auksion lotlari. Bitta kadastr obyekti bo'lib-bo'lib bir nechta lotga chiqarilishi
// mumkin (real ma'lumotda bitta obyektda 13 tagacha ijara loti uchradi).
model AuctionLot {
  id              String         @id @default(cuid())
  propertyId      String
  property        Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type            AuctionLotType
  lotNumber       String?
  orderId         Int?
  /**
   * Shu lotga chiqarilgan maydon (kv.m)
   */
  area            Decimal?       @db.Decimal(14, 2)
  startPrice      Decimal?       @db.Decimal(18, 2)
  auctionDate     DateTime?
  lotStatus       String?
  orderStatus     String?
  /**
   * Lot nomi (API 6 dagi `name`)
   */
  name            String?
  matchedByOldCad Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([propertyId])
  @@index([lotNumber])
  @@index([type])
  // Auksion trendi shu ustun bo'yicha 24 oylik oraliqni skanerlaydi.
  @@index([auctionDate])
}

// Ijara shartnomalari (API 5). Bitta kadastrda bir nechta shartnoma bo'lishi mumkin
// (real ma'lumotda maksimal 18 tagacha uchradi).
model RentContract {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractNumber  String?
  contractDate    DateTime?
  contractSum     Decimal?  @db.Decimal(18, 2)
  rentalArea      Decimal?  @db.Decimal(14, 2)
  ownerTin        String?
  ownerName       String?
  tenantTin       String?
  tenantName      String?
  docLink         String?
  regionName      String?
  districtName    String?
  /**
   * Shu shartnoma ESKI kadastr raqami orqali topilganmi.
   */
  matchedByOldCad Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([propertyId])
  @@index([contractNumber])
  // Boshqaruv panelidagi oylik ijara trendi shu ustun bo'yicha 24 oylik oraliqni skanerlaydi.
  @@index([contractDate])
}

// API 3–8 natijalari (har bir manba uchun bitta qator)
model ObjectStatusCheck {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  apiSource       String // "API3".."API8", "AUCTION", "WATER" | "GAS" | "ELECTRIC"
  found           Boolean  @default(false)
  matchedByOldCad Boolean  @default(false) // fallback ishga tushdimi
  status          String? // API qaytargan holat
  rawResponse     Json?
  checkedAt       DateTime @default(now())

  @@unique([propertyId, apiSource])
  @@index([apiSource, status])
}

// Kategoriya biriktirish (asosan MANUAL 5–10 uchun, tarix bilan)
model PropertyCategoryAssignment {
  id           String    @id @default(cuid())
  propertyId   String
  property     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  categoryCode Int
  category     Category  @relation(fields: [categoryCode], references: [code])
  assignedById String
  assignedBy   User      @relation("AssignedBy", fields: [assignedById], references: [id])
  documentId   String? // asoslovchi PDF
  document     Document? @relation(fields: [documentId], references: [id])
  note         String?
  createdAt    DateTime  @default(now())

  @@index([propertyId])
  @@index([categoryCode])
}

// PDF hujjatlar (local filesystem'da saqlanadi, DB'da faqat metadata)
model Document {
  id             String                       @id @default(cuid())
  propertyId     String
  property       Property                     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User                         @relation("UploadedBy", fields: [uploadedById], references: [id])
  storageKey     String // nisbiy yo'l: region/<id>/property/<cad>/<uuid>.pdf
  fileName       String
  fileSize       Int
  mimeType       String                       @default("application/pdf")
  assignments    PropertyCategoryAssignment[]
  changeRequests CategoryChangeRequest[]
  createdAt      DateTime                     @default(now())

  // Ilova rasmlari (ixtiyoriy, 4tagacha) asosiy PDF hujjatning "bolalari" sifatida
  // saqlanadi — shunda so'rov ham, darhol biriktirish ham bitta FK bilan ishlaydi
  // va PDF o'chirilganda rasmlar ham kaskad o'chadi.
  parentId String?
  parent   Document?  @relation("DocAttachments", fields: [parentId], references: [id], onDelete: Cascade)
  children Document[] @relation("DocAttachments")

  @@index([propertyId])
  @@index([parentId])
}

// ─────────────────── Kategoriya o'zgartirish so'rovi (workflow) ───────────────────
// IJROCHI "Bo'sh turgan" obyektni "Yaroqsiz holat"/"Chekka hudud"ga biriktirish
// SO'ROVINI yuboradi. So'rov IKKI BOSQICHDAN o'tadi va faqat oxirida qo'llanadi:
//   PENDING_MODERATOR  → moderator obyektni o'rganadi, qabul qiladi yoki rad etadi
//   PENDING_RAHBARIYAT → rahbariyat yakuniy qaror qabul qiladi
//   APPROVED           → kategoriya qo'llandi
//   REJECTED           → rad etildi (sababi bilan, ijrochiga xabar boradi)
enum ChangeRequestStatus {
  PENDING_MODERATOR
  PENDING_RAHBARIYAT
  APPROVED
  REJECTED
}

model CategoryChangeRequest {
  id            String              @id @default(cuid())
  propertyId    String
  property      Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                @relation("RequestedBy", fields: [requestedById], references: [id])
  fromCategory  Int? // so'rov paytidagi effektiv kategoriya (odatda 11)
  toCategory    Int // 9 (yaroqsiz) yoki 10 (chekka)
  note          String?
  documentId    String?
  document      Document?           @relation(fields: [documentId], references: [id])
  status        ChangeRequestStatus @default(PENDING_MODERATOR)

  // 1-bosqich — moderator (qabul qiluvchi)
  moderatorId   String?
  moderator     User?     @relation("ModeratorReview", fields: [moderatorId], references: [id])
  moderatorNote String?
  moderatorAt   DateTime?

  // 2-bosqich — rahbariyat (yakuniy qaror)
  rahbarId   String?
  rahbar     User?     @relation("RahbarReview", fields: [rahbarId], references: [id])
  rahbarNote String?
  rahbarAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([propertyId])
  @@index([requestedById])
}

// Ilova ichidagi bildirishnoma (email yo'q). Nazoratchiga tasdiq/rad haqida xabar.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ─────────────────────── Sinxronizatsiya jurnali ─────────────────────
enum SyncRunType {
  FULL_ALL
  REGION
  SINGLE
  STATUS_REFRESH // API1/2 siz — mavjud obyektlarga to'g'ridan-to'g'ri holat-API'lar (3-6)
}

enum SyncRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

model SyncRun {
  id             String        @id @default(cuid())
  type           SyncRunType
  status         SyncRunStatus @default(QUEUED)
  triggeredById  String?
  triggeredBy    User?         @relation("TriggeredBy", fields: [triggeredById], references: [id])
  regionId       String?
  // Soha (OrganizationSource.name) bo'yicha kesim — hudud bilan birga qo'llanadi.
  sourceName     String?
  // STATUS_REFRESH uchun: qaysi modullar tashqi API'dan qayta so'raladi.
  // FULL_ALL/REGION/SINGLE uchun uchalasi ham true (to'liq zanjir, o'zgarmagan xulq-atvor).
  refreshBase    Boolean       @default(true) // API2 — asosiy ma'lumot
  refreshAuction Boolean       @default(true) // API3/4 + API6 — auksion va ijara loti (birga, AuctionLot bitta jadval)
  refreshRent    Boolean       @default(true) // API5 — ijara shartnomalari
  refreshUtility Boolean       @default(true) // suv/gaz/elektr — kommunal abonent tekshiruvi
  totalCount     Int           @default(0)
  successCount   Int           @default(0)
  failCount      Int           @default(0)
  /**
   * Xato xabari -> nechta marta uchragani: `{ "API2: HTTP 500": 12, ... }`.
   * ⚠️ Nima uchun shu yerda saqlanadi: `Property.lastSyncError` faqat OXIRGI holatni
   * saqlaydi, ya'ni keyingi sinxronizatsiya o'sha obyektni yangilasa, avvalgi run'ning
   * xatosi izsiz yo'qolardi va tarixdagi "xato: 33" soni tushuntirib bo'lmas holga
   * kelardi (jonli ma'lumotda aynan shunday bo'lgan). Bu ustun run yakunlangandan
   * keyin ham o'zgarmaydi.
   */
  failureSummary Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

// Audit (kim, nima, qachon)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // "ASSIGN_CATEGORY", "UPLOAD_DOC", "TRIGGER_SYNC"...
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────── Ijara imtiyozi (ПҚ-3782) ─────────────────
// Mehnat shartnomasi asosida ishlayotgan xodimlarning kamida 30% ini nogironligi
// bo'lgan shaxslar tashkil etsa, ijara to'lovi auksion summasining 50% i etib
// belgilanadi. Uchta tashqi manba: Soliq comp_workers (yuridik shaxs),
// Soliq yatt_workers (YATT) va TIEK minzdrav_pas (nogironlik reyestri).

/// Javobning YAGONA ishonchli maydoni — UI hech qachon xabar MATNini solishtirmaydi.
/// ⚠️ `INCONCLUSIVE_*` = "aniqlanmadi" (isEligible NULL), rad javobi EMAS.
enum ImtiyozResultCode {
  ELIGIBLE // ≥30% — imtiyoz qo'llaniladi
  NOT_ELIGIBLE // <30%, ma'lumot TO'LIQ
  NO_WORKERS // baza javob berdi, shartnoma yo'q — haqiqiy fakt
  INCONCLUSIVE_SOLIQ // xodimlar ro'yxati olinmadi yoki qisman
  INCONCLUSIVE_TIEK // ≥1 xodim nogironlik reyestrida tekshirilmadi
  INCONCLUSIVE_YATT_INDEX // YATT indeksi to'liq sinxronlanmagan
}

enum ImtiyozSubjectType {
  STIR // 9 xonali — yuridik shaxs
  JSHSHIR // 14 xonali — yakka tartibdagi tadbirkor
}

enum ImtiyozWorkerStatus {
  DISABLED
  NOT_DISABLED
  NOT_FOUND // TIEK bazasida bunday PINFL yo'q (result_code 1001)
  FAILED // TIEK javob bermadi — holat NOMA'LUM
}

/// Audit jurnali: FAQAT QO'SHILADI (kodda UPDATE/DELETE yo'li yo'q).
/// Har bir BERISH alohida yozuv — keshdan berilganda ham. Audit "kimga qachon nima
/// aytilgan"ga javob beradi, "qachon hisoblangan"ga emas.
model ImtiyozCheck {
  id String @id @default(cuid())

  /// Har bir berish uchun alohida. Keshdan berilganda `sourceRequestId` asl hisoblashga ishora qiladi.
  requestId       String  @unique
  sourceRequestId String?

  createdAt  DateTime @default(now()) // javob BERILGAN payt
  computedAt DateTime // natija HISOBLANGAN payt (keshda eskiroq)

  /// Hisob o'chirilsa ham "kim tekshirgan" javobi yo'qolmasin — `username`
  /// denormalizatsiya qilingan. Ochiq endpoint (shartnoma formasi) uchun
  /// `userId` NULL va `username` = "forma".
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])
  username String
  clientIp String?

  subjectId   String
  subjectType ImtiyozSubjectType
  year        Int
  period      Int
  isRetry     Boolean            @default(false)
  fromCache   Boolean            @default(false)

  resultCode ImtiyozResultCode
  /// NULL = aniqlab bo'lmadi. ⚠️ `false` + to'liqsiz ma'lumot HECH QACHON yozilmaydi
  /// (`assertNoFalseNegative`) — yagona istisno `NO_WORKERS`.
  isEligible Boolean?

  totalWorkers       Int
  checkedCount       Int
  disabledCount      Int
  requiredCount      Int
  disabledPercentage Float?
  notDisabledCount   Int    @default(0)
  notFoundCount      Int    @default(0)
  failedCount        Int    @default(0)

  yattIndexIncomplete Boolean @default(false)
  yattIndexReady      Boolean @default(true)
  soliqError          String? // "kind: message"

  message    String
  durationMs Int?
  appVersion String?

  workers ImtiyozCheckWorker[]

  @@index([createdAt])
  @@index([subjectId, createdAt])
  @@index([username, createdAt])
  @@index([resultCode, createdAt])
}

/// Tekshiruv paytidagi xodimlar ro'yxati — arxiv nusxasi jonli natija bilan
/// aynan bir xil ko'rinishi uchun saqlanadi.
/// ⚠️ PII: PINFL, F.I.Sh., nogironlik guruhi va ICD-10 kodi.
model ImtiyozCheckWorker {
  id      String       @id @default(cuid())
  checkId String
  check   ImtiyozCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  ord      Int // Soliq bergan tartib
  pinfl    String
  position String?
  rate     String?
  status   ImtiyozWorkerStatus

  fullName          String?
  birthOn           String?
  disabilityGroup   Int?
  disabilityStartOn String?
  disabilityEndOn   String?
  icd10Code         String?

  fromCache    Boolean @default(false)
  errorMessage String?

  @@index([checkId])
  @@index([pinfl])
}

/// YATT ishchilar indeksi.
///
/// ⚠️ `yatt_workers` endpoint `entrepreneurPinfl` bo'yicha FILTRLAMAYDI — har bir so'rov
/// BUTUN respublika bo'yicha shartnoma yozuvlarini qaytaradi (~76 000+). Shuning uchun
/// har bir tekshiruvda jonli so'rash imkonsiz: ro'yxat fon rejimida (worker, pg-boss
/// jadvali) to'liq yuklanib shu jadvalga yoziladi.
///
/// Bekor qilingan yoki muddati o'tgan shartnomalar yozilmaydi — jadvalda faqat FAOL
/// bog'lanishlar bo'ladi.
model ImtiyozYattWorker {
  entrepreneurPinfl String
  workerPinfl       String

  @@id([entrepreneurPinfl, workerPinfl])
  @@index([entrepreneurPinfl])
}

/// Indeksning holati — bitta qator (`id = "singleton"`).
///
/// ⚠️ `ready`/`failedPages` siz bo'sh indeks "nol xodim" deb talqin qilinardi. To'liq
/// sinxronlanmagan indeksda topilmagan JSHSHIR uchun natija HAR DOIM
/// `INCONCLUSIVE_YATT_INDEX` bo'ladi — "xodim yo'q" degan xulosa asossiz.
model ImtiyozYattSync {
  id String @id @default("singleton")

  ready       Boolean   @default(false)
  syncing     Boolean   @default(false)
  startedAt   DateTime?
  finishedAt  DateTime? // oxirgi MUVAFFAQIYATLI yakun
  totalPages  Int       @default(0)
  failedPages Int       @default(0)

  entrepreneurCount Int     @default(0)
  recordCount       Int     @default(0)
  lastError         String?

  updatedAt DateTime @updatedAt
}

/// TIEK (nogironlik reyestri) keshi. Holat kunlar davomida o'zgarmaydi, shuning uchun
/// 400 xodimli korxonani qayta tekshirganda reyestrga qayta so'rov ketmaydi.
///
/// ⚠️ FAQAT aniq javob keshlanadi (topildi / result_code 1001). Tizim xatosi
/// KESHLANMAYDI — aks holda vaqtinchalik uzilish 24 soatga "nogironligi yo'q"
/// bo'lib muzlab qolardi. Shu sababli "qayta tekshirish" faqat muvaffaqiyatsiz
/// PINFL'lar uchun so'rov yuboradi.
model ImtiyozTiekCache {
  pinfl      String   @id
  isDisabled Boolean
  notFound   Boolean  @default(false)
  /// TIEK yozuvidan TANLAB olingan maydonlar (butun blob emas).
  person     Json?
  checkedAt  DateTime @default(now())

  @@index([checkedAt])
}

/// Yakuniy natija keshi (`subjectId_year_period`) — bir xil STIR ketma-ket bir necha
/// marta tekshirilishining oldini oladi.
///
/// ⚠️ `NO_WORKERS` KESHLANMAYDI: xodim qo'shilishi mumkin, keyingi so'rov yangi
/// javob olsin. "Aniqlanmadi" holatlari ham keshlanmaydi.
model ImtiyozResultCache {
  key        String   @id // "{subjectId}_{year}_{period}"
  requestId  String // asl hisoblashning requestId'si (audit zanjiri uzilmasin)
  result     Json
  computedAt DateTime
  expiresAt  DateTime

  @@index([expiresAt])
}

// ─────────────────────────── Bo'limlar ko'rinishi ───────────────────────────

enum SectionVisibility {
  SUPER_ONLY // faqat super admin (yangi bo'limning standart holati)
  ROLES // super admin + `roles` ro'yxatidagilar
  EVERYONE // `SectionDef.allowRoles` doirasidagi hamma
}

/**
 * Bir bo'lim = bir qator. Bo'limlarning O'ZI kodda e'lon qilinadi
 * (`src/lib/sections.ts`), bu jadval faqat KIMGA KO'RINISHINI saqlaydi —
 * shuning uchun UI'dan yangi qator yaratilmaydi, faqat mavjudi tahrirlanadi.
 * ⚠️ QATOR YO'Q BO'LSA — `SUPER_ONLY` deb qaraladi (`sectionAccess.ts`).
 * Ya'ni yangi bo'lim qo'shib deploy qilinganda, hech narsa sozlanmasa ham u
 * avtomatik faqat super adminga ko'rinadi (fail-closed). Bu ataylab: unutilgan
 * bo'lim yashirin qoladi, ochilib ketmaydi.
 * ⚠️ `roles` bazada cheklanmaydi — chegara `SectionDef.allowRoles` orqali
 * KODDA qo'yiladi va o'qish paytida kesishma olinadi. Sabab: chegara kod bilan
 * birga o'zgaradi (yangi rol qo'shilishi mumkin), migratsiya bilan emas.
 */
model SectionAccess {
  key        String            @id
  visibility SectionVisibility @default(SUPER_ONLY)
  roles      Role[]            @default([])

  updatedById String?
  updatedBy   User?    @relation("SectionAccessUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────── Kunlik snapshot ───────────────────────────

/**
 * Boshqaruv panelidagi ko'rsatkichlarning KUNLIK o'lchovi.
 * ⚠️ **Sabab:** `Property` ning statistika ustunlari har sinxronizatsiyada USTIDAN
 * yoziladi, `ObjectStatusCheck` da esa `@@unique([propertyId, apiSource])` — ya'ni
 * "o'tgan oyda nechta obyekt bo'sh turgan edi" degan savolga bazada javob YO'Q.
 * Bu jadval o'sha bo'shliqni to'ldiradi: har kuni bir marta joriy holat yoziladi.
 * ⚠️ **Tarixni backfill qilib BO'LMAYDI** — o'tmishdagi holat hech qayerda saqlanmagan.
 * Shuning uchun jadval bo'sh bo'lganda grafik NOL chiziq chizmaydi, umuman
 * ko'rsatilmaydi (aks holda "hech narsa o'zgarmadi" degan yolg'on xulosa chiqardi).
 * **Gran — `(day, sourceId, regionId)`.** Barcha kesimlar shundan YIG'INDI bilan
 * tiklanadi: rol doirasi (`sourceIds`), soha filtri (JOIN orqali `name`), hudud kesimi.
 * Faqat hudud grani `sourceIds` doirasini tiklay olmasdi, faqat manba grani esa
 * hudud kesimini bera olmasdi — shuning uchun ikkalasi birga.
 * ⚠️ **`soha` (nom) ustuni ATAYLAB yo'q.** `OrganizationSource.name` admin UI'da
 * qayta nomlanishi mumkin — nom saqlansa tarix ikkiga bo'linib qolardi. JOIN esa
 * har doim joriy nomni beradi.
 * ⚠️ **Kalitda NULL yo'q** (ikkala ustun ham NOT NULL) — loyihada bu naqsh
 * allaqachon bir marta buzgan: `@@unique([regionId, stir])` da `regionId` NULL
 * bo'lganda Postgres NULL'larni farqli deb hisoblab dublikatni o'tkazib yuborgan.
 * Bu yerda `Property.sourceId`/`regionId` ikkalasi ham majburiy, ya'ni muammo yo'q.
 */
model DashboardSnapshot {
  /**
   * O'lchov sanasi — **Asia/Tashkent** kuni (`snapshots.ts`), UTC emas.
   */
  day      DateTime           @db.Date
  sourceId String
  source   OrganizationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  regionId String
  region   Region             @relation(fields: [regionId], references: [id], onDelete: Cascade)

  /**
   * Balansdagi obyektlar soni (`removedFromBalance = false` — `sourceCond()` bilan bir xil).
   */
  totalObjects    Int
  /**
   * Effektiv kategoriyasi 11 ("Bo'sh turgan").
   */
  vacantObjects   Int
  /**
   * Shundan FAQAT binolar (`NOT isLand`) — `landSplit` sohalarida (Davlat aktivlari
   * agentligi / Direksiya) kartada aynan shu son ko'rsatiladi.
   */
  vacantBuildings Int
  /**
   * Ijara shartnomasi bor obyektlar (`rentContractCount > 0`) — kategoriyadan mustaqil.
   */
  rentedObjects   Int
  /**
   * Shartnomalar soni (obyektlar bo'yicha yig'indi).
   */
  contractCount   Int

  rentArea   Decimal @db.Decimal(18, 2)
  rentSum    Decimal @db.Decimal(20, 2)
  /**
   * Bo'sh maydon yig'indisi (`Property.vacantArea` = foydali − ijarada).
   */
  vacantArea Decimal @db.Decimal(18, 2)

  /**
   * O'lchov QACHON olingani. Kun ichida qayta olinganda yangilanadi va shu bilan
   * eskirgan qatorlarni topish imkonini beradi (`snapshots.ts` — manbasi yo'qolgan
   * (manba, hudud) juftligi kun ichida qolib ketmasin).
   */
  takenAt DateTime

  @@id([day, sourceId, regionId])
  @@index([day])
}

// ───────────────────── Auksion buyurtmalari (get-order API) ─────────────────────
//
// ⚠️ MUSTAQIL QUYI TIZIM — `Property`/`AuctionLot` ga BOG'LANMAGAN va ularga ta'sir
// qilmaydi. Farqi:
//   `AuctionLot` — kadastr bo'yicha bittalab so'raladi (API 3/4/6), faqat BIZNING
//                  bazadagi obyektlar uchun, har sinxronizatsiyada qayta yoziladi.
//   `AuctionOrder` — 14 viloyat akkaunti bo'yicha auksion tizimidagi BARCHA
//                  buyurtmalar (2026-09-07 o'lchovi: 68 196 ta), obyektlarimiz
//                  bilan kesishmasligi ham mumkin. Tarixiy yozuv sifatida saqlanadi.
//
// ⚠️ SHAXSIY MA'LUMOT: g'olibning F.I.Sh., passport, JSHSHIR, telefon, manzili va
// bank hisob raqami shu jadvalda. Bo'lim `allowRoles` da faqat adminga ochiq
// (`lib/sections.ts` → `auksion`) — kengaytirishdan oldin shuni hisobga oling.
model AuctionOrder {
  /**
   * Auksion tizimidagi `order_id` — global unikal, upsert kaliti (skript ham shunday).
   */
  orderId    Int  @id
  oldOrderId Int?
  newOrderId Int?

  /**
   * Qaysi akkaunt (viloyat) orqali olingan — `.env.auction` dagi `name` (QR, AND, ...).
   * ⚠️ `region` maydonidan FARQ QILADI: bu — so'rov yuborilgan akkaunt, u esa
   * buyurtmaning o'z hududi. Odatda mos keladi, lekin kafolat yo'q.
   */
  credential String

  name        String?
  region      String?
  regionSoato String?
  area        String?
  /**
   * Tuman SOATO kodi — `District.code` bilan bir xil kodlash (API 2 `district_id`).
   */
  areaSoato   String?
  address     String?

  groupName    String?
  categoryName String?
  categoryId   Int?

  orderStatus     String?
  orderStatusesId Int?
  lotStatus       String?
  lotStatusesId   Int?
  lotNumber       String?

  startPrice    Decimal? @db.Decimal(18, 2)
  paidPrice     Decimal? @db.Decimal(18, 2)
  soldPrice     Decimal? @db.Decimal(18, 2)
  centerFee     Decimal? @db.Decimal(18, 2)
  fullPricePaid Int?
  withDiscount  Int?
  termPayment   Int?
  termMonth     Int?

  // ⚠️ Sanalar API'da "DD.MM.YYYY" yoki "DD.MM.YYYY HH:mm:ss" ko'rinishida keladi
  // (ISO EMAS) — `parseDotDateTime()` bilan o'giriladi, API 4 dagi bilan bir xil tuzoq.
  lotPlaceDate      DateTime?
  auctionDate       DateTime?
  firstLotPlaceDate DateTime?
  firstAuctionDate  DateTime?
  lotAcceptedTime   DateTime?

  customerName  String?
  customerInn   String?
  customerSoato String?

  // ── Shaxsiy ma'lumot (yuqoridagi ogohlantirishga qarang) ──
  winnerName             String?
  winnerInn              String?
  winnerPassport         String?
  winnerPinfl            String?
  winnerPhone            String?
  winnerAddress          String?
  winnerPassportDate     DateTime?
  winnerPassportIssuedBy String?
  winnerSubjectType      Int?

  bankName String?
  bankMfo  String?

  lat Float?
  lng Float?

  protocolFileUrl    String?
  isDowngradeAuction Int?
  propSet            Int?
  acceptState        Int?
  score              Float?

  /**
   * To'liq xom javob. ⚠️ `rawApi2` bilan bir xil sabab: mantiq o'zgarsa 68 000
   * buyurtmani 20 daqiqa davomida qayta yuklamasdan qayta hisoblash mumkin.
   * Ustunlarga chiqarilmagan maydonlar ham shu yerda (`details`, `images`,
   * `documents`, `winner_payments`, `scoring_params`, izohlar).
   */
  raw Json?

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([credential])
  @@index([region])
  @@index([auctionDate])
  @@index([orderStatusesId])
  @@index([lotNumber])
  @@index([customerInn])
}

/**
 * Auksion reyestrini yuklash jarayoni — ekranda "yangilanmoqda" ko'rsatish uchun.
 * ⚠️ `SyncRun` dan ALOHIDA: u obyektlar pipeline'iga (API1/2 fan-out, leaf job
 * hisoblagichlari, `assertNoActiveRun`) mahkam bog'langan. Auksion reyestri esa
 * mustaqil quyi tizim — uni o'sha jadvalga tiqish ikkalasining ham mantiqini
 * chalkashtirardi.
 * ⚠️ Har yozuv EMAS, har SAHIFA yakunida yangilanadi (~1 360 marta) — yozuv
 * boshiga update 68 000 ta ortiqcha UPDATE degani bo'lardi.
 */
model AuctionSyncRun {
  id         String            @id @default(cuid())
  status     AuctionSyncStatus @default(RUNNING)
  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  /**
   * Hozir yuklanayotgan akkaunt (QR, AND …) — tugagach oxirgisi qoladi.
   */
  credential      String?
  credentialIndex Int     @default(0)
  credentialTotal Int     @default(0)
  /**
   * Joriy akkaunt ichidagi sahifa.
   */
  page            Int     @default(0)
  pages           Int     @default(0)

  /**
   * Butun run bo'yicha jamlanma.
   */
  saved   Int @default(0)
  skipped Int @default(0)

  /**
   * Akkaunt kesimidagi natija: [{name, saved, pages, error?}].
   */
  perCredential Json?
  /**
   * Butun run yiqilgan bo'lsa — sababi.
   */
  error         String?

  /**
   * Kim ishga tushirgan (`null` = kunlik cron).
   */
  startedById String?

  @@index([startedAt])
  @@index([status])
}

enum AuctionSyncStatus {
  RUNNING
  DONE
  /**
   * Ba'zi akkauntlar xato bergan, lekin run oxirigacha yetgan.
   */
  PARTIAL
  FAILED
}

# Windows'da ishlab, Linux konteynerda ishga tushiramiz.
# Shell skript va Docker fayllari LF bilan saqlanishi shart — CRLF bo'lsa
# Linuxda "bad interpreter" / "not found" xatosi chiqadi.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binar fayllar — tegilmasin
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ico binary
*.xlsx binary

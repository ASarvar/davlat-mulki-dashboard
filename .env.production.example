# Production (Docker / Linux) uchun namuna.
# Serverda nusxa oling va to'ldiring:  cp .env.production.example .env.production
# ⚠️ .env.production git'ga TUSHMAYDI (.gitignore) — sirlar shu yerda.
#
# Windows'dagi dev uchun bu fayl KERAK EMAS — u yerda avvalgidek `.env` ishlatiladi.

# ─── PostgreSQL konteyneri (db servisi shu uchtasini o'qiydi) ───
POSTGRES_USER=davlat
POSTGRES_PASSWORD=<kuchli-parol-yozing>
POSTGRES_DB=davlat_mulki

# ─── Ilova bazaga qanday ulanadi ───
# Host = `db` (compose servisi nomi), port = 5432 (konteyner ichida, 5433 EMAS).
# Parol yuqoridagi POSTGRES_PASSWORD bilan bir xil bo'lishi shart.
# connection_limit — worker WORKER_CONCURRENCY bilan mos bo'lsin.
DATABASE_URL=postgresql://davlat:<kuchli-parol-yozing>@db:5432/davlat_mulki?schema=public&connection_limit=30

# ─── Auth.js ───
# Yaratish (Linux):  openssl rand -base64 32
NEXTAUTH_SECRET=<32-baytlik-tasodifiy-satr>
# ⚠️ Foydalanuvchi brauzerga yozadigan manzil bilan AYNAN bir xil bo'lsin,
#    aks holda login cheksiz redirect qiladi. nginx ortida — tashqi domen.
NEXTAUTH_URL=https://monitoring.example.uz

# ─── Boshlang'ich super-admin (faqat `--profile setup` seed uchun) ───
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=<boshlangich-parol-birinchi-kirishdan-keyin-almashtiring>

# ─── Fayl saqlash ───
# Konteyner ichidagi yo'l — compose'da `uploads` volume shu yerga ulanadi.
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_BYTES=15728640

# ─── Vaqt mintaqasi (sana formatlari uchun) ───
TZ=Asia/Tashkent

# ─── Worker (pg-boss) ───
WORKER_CONCURRENCY=25
WORKER_POLL_SECONDS=1

# ─── Tashqi API'lar ───
# ⚠️ Serverdan 192.168.1.254 ga yo'l bo'lishi shart (docker bridge tarmog'i
#    host orqali chiqadi — qo'shimcha sozlash kerak emas). Tekshirish:
#    docker compose exec worker sh -c "getent hosts 192.168.1.254 || echo yoq"
API1_BASE_URL=
API1_PATH=
API2_BASE_URL=
API2_PATH=
API2_TOKEN=

API3_BASE_URL=
API4_BASE_URL=
AUCTION_API_USER=
AUCTION_API_PASSWORD=
API3_PARAM=cad_number
API4_PARAM=order

API5_BASE_URL=
API5_USERNAME=
API5_PASSWORD=
API5_PARAM=cadastre_number

API6_BASE_URL=
API6_USERNAME=
API6_PASSWORD=
API6_PARAM=cad_number

# ─── Rate limit / retry ───
API_RATE_MAX=10
API_RATE_DURATION_MS=1000
API_MAX_ATTEMPTS=5
API_TIMEOUT_MS=15000
